{
  "manifest_version": 3,
  "name": "InstantSign PDF - Private & Offline Signer",
  "short_name": "InstantSign",
  "version": "1.0.1",
  "description": "Sign PDF documents, add your signature, name, ID and date 100% locally without uploading files to any server.",
  "action": {
    "default_title": "Open InstantSign PDF",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
